[Unit]
Description=Sababisha Celery Beat Scheduler (Native)
After=network.target redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sababisha-celery

# Activate virtual environment and run celery beat
ExecStart=/opt/sababisha-celery/venv/bin/celery -A celery_config:app beat --loglevel=debug

# Environment variables (load from .env)
EnvironmentFile=/opt/sababisha-celery/.env

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sababisha-celery-beat

[Install]
WantedBy=multi-user.target
